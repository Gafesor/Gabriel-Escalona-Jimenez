rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper para datos entrantes y existentes
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // =========================================================================
    // VALIDACIÓN DE COTIZACIONES (QUOTES)
    // =========================================================================
    // Ataque mitigado: Inyección de datos malformados, valores monetarios negativos o desbordamiento de memoria por arrays gigantes (DoS).
    function isValidQuoteStructure(data) {
      return data.keys().hasAll(['id', 'folio', 'operatorName', 'status', 'total', 'items', 'createdAt', 'updatedAt', 'isArchived'])
        && data.id is string
        && data.folio is string && data.folio.size() <= 32
        && data.operatorName is string && data.operatorName.size() <= 100
        && data.status in ['borrador', 'enviada', 'revision', 'aprobada', 'produccion', 'entregada', 'cancelada']
        && data.total is number && data.total >= 0
        && data.items is list && data.items.size() <= 50
        && data.createdAt is string && data.createdAt.size() <= 64
        && data.updatedAt is string && data.updatedAt.size() <= 64
        && data.isArchived is bool;
    }

    match /quotes/{quoteId} {
      // Lectura permitida para el panel de cotizaciones del taller
      allow read: if true;

      // Creación: Validación estricta de estructura y no borrado lógico en creación
      allow create: if isValidQuoteStructure(incoming())
        && quoteId == incoming().id
        && (!('deletedAt' in incoming()) || incoming().deletedAt == null);

      // Actualización:
      // Inmutabilidad estricta de folio y fecha de creación
      allow update: if isValidQuoteStructure(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().folio == existing().folio;

      // Permitir borrado de borradores o cotizaciones archivadas para limpieza de taller
      allow delete: if resource.data.status == 'borrador' || resource.data.isArchived == true;
    }

    // =========================================================================
    // CATÁLOGOS Y CONFIGURACIÓN DEL TALLER (SETTINGS, MATERIALS, PRINTERS, PRESETS)
    // =========================================================================
    match /{catalogCollection}/{docId} {
      allow read: if catalogCollection in ['settings', 'materials', 'printers', 'consumables', 'presets', 'postprocesses', 'clients'];
      allow write: if catalogCollection in ['settings', 'materials', 'printers', 'consumables', 'presets', 'postprocesses', 'clients'];
    }

    // =========================================================================
    // SECUENCIADOR TRANSACCIONAL DE FOLIOS (COUNTERS/FOLIO)
    // =========================================================================
    match /counters/{counterId} {
      allow read: if true;
      allow write: if counterId == 'folio'
        && incoming().current is int
        && incoming().current >= 0;
    }

    // =========================================================================
    // CATCH-ALL DE SEGURIDAD ESTRICTA (ZERO TRUST)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
